   "source": [
    "# --- Dynamic decoding sweep: use max_new_tokens = int(ref_tokens*1.05) across full batch\n",
    "import csv\n",
    "from tqdm import tqdm\n",
    "\n",
    "dynamic_results = []\n",
    "for rec in tqdm(batch_records, desc='Dynamic-cap decoding across batch'):\n",
    "    sample_idx = rec['sample_index']\n",
    "    text = rec['text']\n",
    "    ref_tokens = rec.get('ref_tokens', None)\n",
    "    if ref_tokens is None or ref_tokens <= 0:\n",
    "        # Fallback: use median or skip\n",
    "        continue\n",
    "    word_count = max(1, len(text.split()))\n",
    "    cap = max(min(word_count * 50, 500), 150)\n",
    "\n",
    "    wav_v, codes_v, diag_v = generate_audio_with_codes(text, model, tokenizer, codec, g2p,\n",
    "                                                       max_new_tokens=cap, temperature=0.2, do_sample=True, top_p=0.9, return_diagnostics=True)\n",
    "    if wav_v is None:\n",
    "        gen_token_count = 0\n",
    "        gen_trim_dur = 0.0\n",
    "    else:\n",
    "        # encode trimmed codes to get trimmed dur and token count\n",
    "        try:\n",
    "            gen_codes_trim, gen_trimmed, _, gen_trim_dur = encode_trimmed_codes(wav_v, sr=24000)\n",
    "            gen_token_count = len(gen_codes_trim)\n",
    "        except Exception:\n",
    "            gen_token_count = diag_v.get('generated_code_count', 0)\n",
    "            gen_trim_dur = len(wav_v) / 24000 if hasattr(wav_v, '__len__') else 0.0\n",
    "\n",
    "    dynamic_results.append({\n",
    "        'sample_index': sample_idx,\n",
    "        'ref_tokens': ref_tokens,\n",
    "        'cap': cap,\n",
    "        'gen_tokens': gen_token_count,\n",
    "        'end_token_seen': diag_v.get('end_token_seen', False),\n",
    "        'hit_token_cap': diag_v.get('hit_token_cap', False),\n",
    "        'gen_trim_dur': gen_trim_dur,\n",
    "        'ref_trim_dur': rec.get('ref_trim_dur', None),\n",
    "        'token_ratio': (gen_token_count / max(1, ref_tokens)) if ref_tokens else None,\n",
    "        'duration_ratio': (gen_trim_dur / max(1e-6, rec.get('ref_trim_dur', 1e-6))) if rec.get('ref_trim_dur', None) else None,\n",
    "    })\n",
    "\n",
    "# Save dynamic sweep CSV\n",
    "dyn_csv = os.path.join(out_dir, 'decoding_dynamic_report.csv')\n",
    "with open(dyn_csv, 'w', newline='', encoding='utf-8') as f:\n",
    "    fieldnames = ['sample_index','ref_tokens','cap','gen_tokens','token_ratio','ref_trim_dur','gen_trim_dur','duration_ratio','end_token_seen','hit_token_cap']\n",
    "    writer = csv.DictWriter(f, fieldnames=fieldnames)\n",
    "    writer.writeheader()\n",
    "    for r in dynamic_results:\n",
    "        writer.writerow({k: r.get(k, '') for k in fieldnames})\n",
    "\n",
    "# Print aggregated stats\n",
    "if dynamic_results:\n",
    "    arr_tokens = np.array([r['gen_tokens'] for r in dynamic_results])\n",
    "    arr_token_ratio = np.array([r['token_ratio'] for r in dynamic_results if r['token_ratio'] is not None])\n",
    "    arr_dur_ratio = np.array([r['duration_ratio'] for r in dynamic_results if r['duration_ratio'] is not None])\n",
    "    print('Dynamic-cap sweep: median_gen_tokens=', np.median(arr_tokens), 'median_token_ratio=', np.median(arr_token_ratio), 'median_duration_ratio=', np.median(arr_dur_ratio))\n",
    "    print('Saved dynamic sweep report to', dyn_csv)\n",
    "else:\n",
    "    print('No dynamic sweep results')"
   ]
  },
