   "source": [
    "out_dir = './diagnostics_outliers'\n",
    "csv_path = os.path.join(out_dir, 'top5_outliers.csv')\n",
    "if not os.path.exists(csv_path):\n",
    "    print('top5_outliers.csv not found in', out_dir)\n",
    "else:\n",
    "    with open(csv_path, 'r', encoding='utf-8') as f:\n",
    "        reader = csv.DictReader(f)\n",
    "        rows = list(reader)\n",
    "\n",
    "    for row in rows:\n",
    "        rank = int(row['rank'])\n",
    "        idx = int(row['sample_index'])\n",
    "        text = row['text']\n",
    "        word_count = max(1, len(text.split()))\n",
    "        cap = max(min(word_count * 50, 500), 150)\n",
    "\n",
    "        print(f\"\\n--- Outlier #{rank} idx={idx} words={word_count} cap={cap} ---\")\n",
    "\n",
    "        wav_unc, codes_unc, diag_unc = generate_audio_with_codes(\n",
    "            text, model, tokenizer, codec, g2p,\n",
    "            max_new_tokens=MAX_DIAG_TOKENS, temperature=0.2, do_sample=True, top_p=None, return_diagnostics=True)\n",
    "\n",
    "        if wav_unc is None:\n",
    "            print('Uncapped generation produced no codes')\n",
    "        else:\n",
    "            try:\n",
    "                gen_codes_trim_unc, gen_trimmed_unc, _, gen_trim_dur_unc = encode_trimmed_codes(wav_unc, sr=24000)\n",
    "                unc_path = os.path.join(out_dir, f'outlier{rank}_idx{idx}_uncapped.wav')\n",
    "                torchaudio.save(unc_path, torch.tensor(gen_trimmed_unc).unsqueeze(0), sample_rate=16000)\n",
    "                print('Uncapped: tokens=', len(gen_codes_trim_unc), 'trim_dur=', gen_trim_dur_unc)\n",
    "                display(ipd.Audio(unc_path))\n",
    "            except Exception as e:\n",
    "                print('Failed encoding/saving uncapped:', e)\n",
    "\n",
    "        wav_cap, codes_cap, diag_cap = generate_audio_with_codes(\n",
    "            text, model, tokenizer, codec, g2p,\n",
    "            max_new_tokens=cap, temperature=0.2, do_sample=True, top_p=None, return_diagnostics=True)\n",
    "\n",
    "        if wav_cap is None:\n",
    "            print('Capped generation produced no codes')\n",
    "        else:\n",
    "            try:\n",
    "                gen_codes_trim_cap, gen_trimmed_cap, _, gen_trim_dur_cap = encode_trimmed_codes(wav_cap, sr=24000)\n",
    "                cap_path = os.path.join(out_dir, f'outlier{rank}_idx{idx}_capped.wav')\n",
    "                torchaudio.save(cap_path, torch.tensor(gen_trimmed_cap).unsqueeze(0), sample_rate=16000)\n",
    "                print('Capped: tokens=', len(gen_codes_trim_cap), 'trim_dur=', gen_trim_dur_cap)\n",
    "                display(ipd.Audio(cap_path))\n",
    "            except Exception as e:\n",
    "                print('Failed encoding/saving capped:', e)\n",
    "\n",
    "print('\\n✓ Dynamic-cap comparison complete. Files saved to', out_dir)\n"
   ]
  }
