   "source": [
    "import csv\n",
    "from scipy.spatial.distance import euclidean\n",
    "\n",
    "MAX_DIAG_TOKENS = 800\n",
    "DIAG_BATCH_SIZE = 20\n",
    "\n",
    "# Helper functions\n",
    "def count_punctuation(text):\n",
    "    return sum(1 for c in text if c in '.,!?;:\\'\"—-')\n",
    "\n",
    "def encode_trimmed_codes(wav, sr, top_db=40):\n",
    "    \"\"\"Trim silence and encode, return (codes, trimmed_wav, raw_dur, trimmed_dur)\"\"\"\n",
    "    if sr != 16000:\n",
    "        wav = librosa.resample(wav, orig_sr=sr, target_sr=16000)\n",
    "        sr = 16000\n",
    "    raw_duration = len(wav) / sr\n",
    "    trimmed_wav = librosa.effects.trim(wav, top_db=top_db)[0]\n",
    "    trimmed_duration = len(trimmed_wav) / sr\n",
    "    wav_norm = normalize_audio(trimmed_wav)\n",
    "    wav_tensor = torch.tensor(wav_norm, dtype=torch.float32).unsqueeze(0).unsqueeze(0).to(device)\n",
    "    with torch.no_grad():\n",
    "        codes = codec.encode_code(wav_tensor)\n",
    "    codes = codes[0].cpu().numpy().flatten().tolist()\n",
    "    return codes, trimmed_wav, raw_duration, trimmed_duration\n",
    "\n",
    "# Load eval batch\n",
    "diag_samples = eval_samples.select(range(min(DIAG_BATCH_SIZE, len(eval_samples))))\n",
    "batch_records = []\n",
    "top_5_outliers = []\n",
    "\n",
    "# Batch processing loop\n",
    "decodes_report = []\n",
    "for sample_idx, sample in enumerate(tqdm(diag_samples, desc='Batch diagnostics')):\n",
    "    text = sample.get(\"text\", sample.get(\"sentence\", \"\"))\n",
    "    ref_wav = np.array(sample[\"audio\"][\"array\"])\n",
    "    ref_sr = sample[\"audio\"][\"sampling_rate\"]\n",
    "    \n",
    "    gen_wav, gen_codes, gen_diag = generate_audio_with_codes(\n",
    "        text, model, tokenizer, codec, g2p, max_new_tokens=MAX_DIAG_TOKENS, \n",
    "        temperature=0.2, do_sample=True, top_p=None, return_diagnostics=True)\n",
    "    if gen_wav is None:\n",
    "        continue\n",
    "    \n",
    "    ref_codes, ref_trimmed, _, ref_trim_dur = encode_trimmed_codes(ref_wav, ref_sr)\n",
    "    gen_codes_trim, gen_trimmed, _, gen_trim_dur = encode_trimmed_codes(gen_wav, sr=24000)\n",
    "    \n",
    "    ratio = len(gen_codes_trim) / max(1, len(ref_codes)) if gen_codes_trim else 0\n",
    "    duration_ratio = gen_trim_dur / max(1e-6, ref_trim_dur)\n",
    "    phones = g2p.phonemize([text])[0].split()\n",
    "    \n",
    "    record = {\n",
    "        'sample_index': sample_idx, 'text': text, 'ratio': ratio, 'duration_ratio': duration_ratio,\n",
    "        'ref_tokens': len(ref_codes), 'gen_tokens': len(gen_codes_trim) if gen_codes_trim else 0,\n",
    "        'phone_count': len(phones), 'ref_trim_dur': ref_trim_dur, 'gen_trim_dur': gen_trim_dur,\n",
    "    }\n",
    "    batch_records.append(record)\n",
    "    top_5_outliers.append((sample_idx, ratio, record))\n",
    "\n",
    "# Get top 5 and save outputs\n",
    "top_5_outliers.sort(key=lambda x: x[1], reverse=True)\n",
    "top_5_outliers = top_5_outliers[:5]\n",
    "out_dir = './diagnostics_outliers'\n",
    "os.makedirs(out_dir, exist_ok=True)\n",
    "\n",
    "# Save CSV\n",
    "outliers_csv = os.path.join(out_dir, 'top5_outliers.csv')\n",
    "with open(outliers_csv, 'w', newline='', encoding='utf-8') as f:\n",
    "    fieldnames = ['rank', 'sample_index', 'text', 'ratio', 'duration_ratio', 'ref_tokens', 'gen_tokens', 'phone_count', 'ref_trim_dur', 'gen_trim_dur']\n",
    "    writer = csv.DictWriter(f, fieldnames=fieldnames)\n",
    "    writer.writeheader()\n",
    "    for rank, (_, _, record) in enumerate(top_5_outliers, 1):\n",
    "        row = {k: record[k] for k in fieldnames if k != 'rank'}\n",
    "        row['rank'] = rank\n",
    "        writer.writerow(row)\n",
    "print(f'Saved top-5 outliers CSV')\n",
    "\n",
    "# Save audio files and run decoding variants\n",
    "decodes_report = []\n",
    "for rank, (sample_idx, ratio, record) in enumerate(top_5_outliers, 1):\n",
    "    sample = diag_samples[sample_idx]\n",
    "    text = record['text']\n",
    "    ref_wav = np.array(sample[\"audio\"][\"array\"])\n",
    "    ref_sr = sample[\"audio\"][\"sampling_rate\"]\n",
    "    ref_codes, ref_trimmed, _, _ = encode_trimmed_codes(ref_wav, ref_sr)\n",
    "    \n",
    "    ref_path = os.path.join(out_dir, f'ref_top{rank}_idx{sample_idx}.wav')\n",
    "    torchaudio.save(ref_path, torch.tensor(ref_trimmed).unsqueeze(0), sample_rate=16000)\n",
    "    \n",
    "    gen_wav, _, _ = generate_audio_with_codes(text, model, tokenizer, codec, g2p, max_new_tokens=MAX_DIAG_TOKENS, \n",
    "                                              temperature=0.2, do_sample=True, top_p=None, return_diagnostics=True)\n",
    "    gen_codes_trim, gen_trimmed, _, _ = encode_trimmed_codes(gen_wav, sr=24000)\n",
    "    gen_path = os.path.join(out_dir, f'gen_top{rank}_idx{sample_idx}.wav')\n",
    "    torchaudio.save(gen_path, torch.tensor(gen_trimmed).unsqueeze(0), sample_rate=16000)\n",
    "    \n",
    "    # Decoding variants\n",
    "    variants = [\n",
    "        {'name':'reduced_tokens_600','max_new_tokens':600,'do_sample':True,'top_p':None},\n",
    "        {'name':'greedy','max_new_tokens':MAX_DIAG_TOKENS,'do_sample':False,'top_p':None},\n",
    "        {'name':'nucleus_top_p_0.9','max_new_tokens':MAX_DIAG_TOKENS,'do_sample':True,'top_p':0.9},\n",
    "    ]\n",
    "    variants_results = []\n",
    "    for var in variants:\n",
    "        wav_v, codes_v, diag_v = generate_audio_with_codes(\n",
    "            text, model, tokenizer, codec, g2p, max_new_tokens=var['max_new_tokens'], \n",
    "            temperature=0.2, do_sample=var['do_sample'], top_p=var['top_p'], return_diagnostics=True)\n",
    "        max_repeat = 0\n",
    "        if codes_v:\n",
    "            max_run = 1\n",
    "            for i in range(1, len(codes_v)):\n",
    "                max_run = max_run + 1 if codes_v[i] == codes_v[i-1] else 1\n",
    "                max_repeat = max(max_repeat, max_run)\n",
    "        variants_results.append({\n",
    "            'variant': var['name'], 'generated_code_count': len(codes_v) if codes_v else 0,\n",
    "            'end_token_seen': diag_v.get('end_token_seen', False), 'hit_token_cap': diag_v.get('hit_token_cap', False),\n",
    "            'max_repeat_run': max_repeat,\n",
    "        })\n",
    "    decodes_report.append({'rank': rank, 'index': sample_idx, 'variants': variants_results})\n",
    "\n",
    "# Save decoding CSV\n",
    "decode_csv = os.path.join(out_dir, 'decoding_variants_report.csv')\n",
    "with open(decode_csv, 'w', newline='', encoding='utf-8') as df:\n",
    "    fieldnames=['rank','index','variant','generated_code_count','end_token_seen','hit_token_cap','max_repeat_run']\n",
    "    writer = csv.DictWriter(df, fieldnames=fieldnames)\n",
    "    writer.writeheader()\n",
    "    for entry in decodes_report:\n",
    "        for v in entry['variants']:\n",
    "            writer.writerow({'rank':entry['rank'],'index':entry['index'],'variant':v['variant'],\n",
    "                           'generated_code_count':v['generated_code_count'],'end_token_seen':v['end_token_seen'],\n",
    "                           'hit_token_cap':v['hit_token_cap'],'max_repeat_run':v['max_repeat_run']})\n",
    "print(f'Saved decoding variants report')\n",
    "\n",
    "# Full batch decoding experiments\n",
    "print('\\n--- Decoding Experiment Stats (Full Batch) ---')\n",
    "all_variants_stats = {'reduced_tokens_600':[],'greedy':[],'nucleus_top_p_0.9':[]}\n",
    "variants_all = [\n",
    "    {'name':'reduced_tokens_600','max_new_tokens':600,'do_sample':True,'top_p':None},\n",
    "    {'name':'greedy','max_new_tokens':MAX_DIAG_TOKENS,'do_sample':False,'top_p':None},\n",
    "    {'name':'nucleus_top_p_0.9','max_new_tokens':MAX_DIAG_TOKENS,'do_sample':True,'top_p':0.9},\n",
    "]\n",
    "for rec in tqdm(batch_records, desc='Full batch decoding variants'):\n",
    "    for var in variants_all:\n",
    "        wav_v, codes_v, diag_v = generate_audio_with_codes(\n",
    "            rec['text'], model, tokenizer, codec, g2p, max_new_tokens=var['max_new_tokens'], \n",
    "            temperature=0.2, do_sample=var['do_sample'], top_p=var['top_p'], return_diagnostics=True)\n",
    "        all_variants_stats[var['name']].append({\n",
    "            'generated_code_count': len(codes_v) if codes_v else 0,\n",
    "            'end_token_seen': diag_v.get('end_token_seen', False),\n",
    "            'hit_token_cap': diag_v.get('hit_token_cap', False),\n",
    "        })\n",
    "\n",
    "for var_name, stats_list in all_variants_stats.items():\n",
    "    if stats_list:\n",
    "        codes_arr = np.array([s['generated_code_count'] for s in stats_list])\n",
    "        end_rate = sum(1 for s in stats_list if s['end_token_seen']) / len(stats_list)\n",
    "        cap_rate = sum(1 for s in stats_list if s['hit_token_cap']) / len(stats_list)\n",
    "        print(f'{var_name}: median={np.median(codes_arr):.0f} p90={np.percentile(codes_arr, 90):.0f} end_rate={end_rate:.2%} cap_rate={cap_rate:.2%}')\n",
    "\n",
    "# Visualize\n",
    "plt.figure(figsize=(8,4))\n",
    "plt.scatter([r['phone_count'] for r in batch_records],[r['ratio'] for r in batch_records], alpha=0.7)\n",
    "plt.xlabel('Phone count')\n",
    "plt.ylabel('Token ratio (gen/ref)')\n",
    "plt.title('Token Ratio vs Phone Count')\n",
    "plt.grid(alpha=0.2)\n",
    "plt.show()\n",
    "print(f'\\n✓ Batch diagnostics complete. Outputs in: {out_dir}')"
   ]
  },
