   "source": [
    "asr_model = whisper.load_model(\"base\")\n",
    "import os\n",
    "from datasets import load_from_disk, load_dataset\n",
    "processed_path = \"./data/processed_romanian_dataset\"\n",
    "\n",
    "if os.path.exists(processed_path):\n",
    "    print(f\"Loading dataset from disk: {processed_path}\")\n",
    "    eval_dataset = load_from_disk(processed_path)\n",
    "    if \"audio\" not in eval_dataset.column_names:\n",
    "        print(\"Warning: Processed dataset is missing 'audio'. Loading raw dataset for reference audio...\")\n",
    "        raw_dataset = load_dataset(\"eduardem/romanian-speech-v2\", split=\"train\")\n",
    "        eval_samples = raw_dataset.select(range(0, 20))\n",
    "    else:\n",
    "        eval_samples = eval_dataset.select(range(0, 20))\n",
    "else:\n",
    "    print(\"Loading dataset from Hugging Face cache...\")\n",
    "    raw_dataset = load_dataset(\"eduardem/romanian-speech-v2\", split=\"train\")\n",
    "    eval_samples = raw_dataset.select(range(0, 20))\n",
    "\n",
    "metrics_results = []\n",
    "\n",
    "for i in tqdm(range(len(eval_samples))):\n",
    "    sample = eval_samples[i]\n",
    "    text = sample.get(\"text\", sample.get(\"sentence\", \"\"))\n",
    "    ref_wav = np.array(sample[\"audio\"][\"array\"])\n",
    "    ref_sr = sample[\"audio\"][\"sampling_rate\"]\n",
    "    \n",
    "    if ref_sr != 16000:\n",
    "        ref_wav = librosa.resample(ref_wav, orig_sr=ref_sr, target_sr=16000)\n",
    "    \n",
    "    gen_wav = generate_audio(text, model, tokenizer, codec, g2p)\n",
    "    \n",
    "    if gen_wav is not None:\n",
    "        # Standardize amplitudes and lengths\n",
    "        ref_wav = normalize_audio(trim_silence(ref_wav))\n",
    "        gen_wav = normalize_audio(trim_silence(gen_wav))\n",
    "        \n",
    "        mcd = calculate_mcd(ref_wav, gen_wav)\n",
    "        sim = calculate_speaker_similarity(ref_wav, gen_wav)\n",
    "        stoi_val = calculate_stoi_score(ref_wav, gen_wav)\n",
    "        f0_rmse = calculate_f0_rmse(ref_wav, gen_wav)\n",
    "        pesq_val = calculate_pesq_score(ref_wav, gen_wav)\n",
    "        lsd_val = calculate_lsd(ref_wav, gen_wav)\n",
    "        \n",
    "        # WER\n",
    "        asr_result = asr_model.transcribe(gen_wav)\n",
    "        error_rate = wer(text.lower(), asr_result[\"text\"].lower())\n",
    "        \n",
    "        metrics_results.append({\n",
    "            \"mcd\": mcd,\n",
    "            \"similarity\": sim,\n",
    "            \"stoi\": stoi_val,\n",
    "            \"f0_rmse\": f0_rmse,\n",
    "            \"pesq\": pesq_val,\n",
    "            \"lsd\": lsd_val,\n",
    "            \"wer\": error_rate\n",
    "        })\n",
    "\n",
    "print(\"\\n--- Final Metrics Summary ---\")\n",
    "for key in [\"mcd\", \"similarity\", \"stoi\", \"f0_rmse\", \"pesq\", \"lsd\", \"wer\"]:\n",
    "    avg = np.mean([r[key] for r in metrics_results])\n",
    "    print(f\"Average {key.upper()}: {avg:.4f}\")"
   ]
  },
